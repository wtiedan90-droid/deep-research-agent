# DeepSeek API configuration. Keep real credentials in .env.
DEEPSEEK_API_KEY=your_deepseek_api_key
LLM_MODEL_NAME=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com

# The duckduckgo integration uses DDGS; choose its engine with DDGS_BACKEND.
SEARCH_API=duckduckgo
DDGS_BACKEND=yahoo

# Extra searches after the first one in a new thread. 0 means one search.
MAX_WEB_RESEARCH_LOOPS=0
FETCH_FULL_PAGE=false
STRIP_THINKING_TOKENS=true

# Optional explicit proxy. Otherwise, the project checks system HTTP/HTTPS proxies.
# DDGS_PROXY=http://127.0.0.1:YOUR_PROXY_PORT

# Optional search integrations; obtain keys from the corresponding service.
# TAVILY_API_KEY=your_tavily_api_key
# PERPLEXITY_API_KEY=your_perplexity_api_key
# SEARXNG_URL=http://localhost:8888
